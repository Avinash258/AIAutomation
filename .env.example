# === Locked M1 defaults (override when you have real values) ===
# Scope: manual + UI automation
# Env: qa | App login: none (use user-pass + npm run ai:save-auth when needed)
# Publish: dry-run ON | Suite: use-existing IDs

APP_ENV=qa
ALLOWED_BASE_URLS=https://example.com,https://qa.example.com
UI_BASE_URL=https://qa.example.com

LOGIN_METHOD=none
UI_USER=
UI_PASSWORD=
STORAGE_STATE_PATH=storage-state.json

# Azure DevOps — browser login (NO PAT)
# 1) Set org + project
# 2) npm run ai:ado-login  (opens browser / device code)
ADO_ORG=
ADO_PROJECT=
ADO_AUTH_MODE=browser
# browser | device-code | az-cli
# Optional: pin Entra tenant
# AZURE_TENANT_ID=

ADO_PBI_ID=
ADO_TEST_PLAN_ID=
ADO_TEST_SUITE_ID=
ADO_SUITE_MODE=use-existing

MAX_PAGES=10
ADO_PUBLISH_DRY_RUN=true
