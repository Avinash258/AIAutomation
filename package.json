    "ai:analyze-site": "tsx scripts/analyze-site.ts",
    "ai:validate-cases": "tsx scripts/validate-cases.ts",
    "ai:traceability": "tsx scripts/traceability.ts",
    "ai:usage": "tsx scripts/log-usage.ts",
