{
  "name": "ai-automation",
  "version": "1.0.0",
  "private": true,
  "description": "M1: ADO PBI → manual cases → Test Plan → site analysis → Playwright UI specs (GitHub Copilot)",
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier -w .",
    "ai:ado-login": "tsx scripts/ado-login.ts",
